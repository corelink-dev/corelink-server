      "svgo@>=3.0.0 <3.3.5": ">=3.3.5 <4",
      "svgo@>=4.0.0 <4.1.0": ">=4.1.0 <5",
      "tmp@<0.2.6": ">=0.2.6 <1",
      "undici@<7.29.0": ">=7.29.0 <8",
      "uuid@<11.1.1": ">=11.1.1 <12",
      "webpack-dev-server@<5.2.6": ">=5.2.6 <6",
      "websocket-driver@<0.7.5": ">=0.7.5 <0.8",
      "ws@<7.5.11": ">=7.5.11 <8",
