      "js-cookie@<3.0.7": ">=3.0.7 <4",
      "js-yaml@<3.15.2": ">=3.15.2 <4",
      "js-yaml@>=4.0.0 <4.3.2": ">=4.3.2 <5",
      "launch-editor@<2.14.1": ">=2.14.1 <3",
      "nanoid@<3.3.17": ">=3.3.17 <4",
