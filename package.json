{
  "name": "corelink-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "CoreLink monorepo root (Rust crates + JS/TS apps via pnpm).",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "patchedDependencies": {
      "@opennextjs/aws@4.0.2": "patches/@opennextjs__aws@4.0.2.patch",
      "@docusaurus/core@3.10.2": "patches/@docusaurus__core@3.10.2.patch"
    },
    "overrides": {
      "@types/react": "^19.0.12",
      "body-parser@<1.20.6": ">=1.20.6 <2",
      "body-parser@>=2.0.0 <2.3.0": ">=2.3.0 <3",
      "baseline-browser-mapping@<2.11.0": ">=2.11.0 <3",
      "browserslist": "4.28.7",
      "brace-expansion@<1.1.17": ">=1.1.17 <2",
      "brace-expansion@>=2.0.0 <2.1.3": ">=2.1.3 <3",
      "brace-expansion@>=3.0.0 <3.0.3": ">=3.0.3 <4",
